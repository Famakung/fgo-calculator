---
import BaseLayout from '../layouts/BaseLayout.astro';
import { QUEST_TIERS, GRAND_CLASSES, GRAND_DIFFICULTIES } from '../scripts/constants.js';
---

<BaseLayout>
<div class="container">
      <nav class="navbar">
        <span class="navbar-title">FGO Calculator</span>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <div class="navbar-tabs" role="tablist" aria-label="Calculator sections">
          <button class="tab-btn" id="tab-servantinfo" data-tab="servantinfo" role="tab" aria-selected="false" aria-controls="panel-servantinfo">Servant Info</button>
          <button class="tab-btn active" id="tab-cefilter" data-tab="cefilter" role="tab" aria-selected="true" aria-controls="panel-cefilter">Bond Gain CE</button>
          <button class="tab-btn" id="tab-bond" data-tab="bond" role="tab" aria-selected="false" aria-controls="panel-bond">Bond Calculator</button>
          <button class="tab-btn" id="tab-event" data-tab="event" role="tab" aria-selected="false" aria-controls="panel-event">Event Shop</button>
        </div>
        <button class="navbar-hamburger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navbarDropdown">
          <span></span><span></span><span></span>
        </button>
        <div class="navbar-dropdown" id="navbarDropdown" aria-hidden="true">
          <button class="navbar-dropdown-item" data-tab="servantinfo">Servant Info</button>
          <button class="navbar-dropdown-item active" data-tab="cefilter">Bond Gain CE</button>
          <button class="navbar-dropdown-item" data-tab="bond">Bond Calculator</button>
          <button class="navbar-dropdown-item" data-tab="event">Event Shop</button>
        </div>
      </nav>

      <main id="main-content">
        <section class="tab-panel" id="panel-servantinfo" role="tabpanel" aria-labelledby="tab-servantinfo">
          <div class="card">
            <div class="card-inner">
              <div class="card-title cefilter-results-header">
                <span>Servants</span>
              </div>
              <div class="cefilter-search-container">
                <input
                  type="text"
                  class="search-filter cefilter-search-input"
                  id="servantInfoSearchInput"
                  aria-label="Search servants by ID or name"
                  placeholder="Search by ID or name..."
                  autocomplete="off"
                />
              </div>
              <div class="cefilter-sort-row">
                <button
                  type="button"
                  class="cefilter-filter-btn"
                  id="servantInfoFilterBtn"
                  aria-haspopup="dialog"
                  aria-label="Open filter settings modal"
                >
                  Filter
                </button>
                <select class="select-field cefilter-sort-select" id="servantInfoSortSelect" aria-label="Sort by">
                  <option value="id" selected>ID</option>
                  <option value="rarity">Rarity</option>
                  <option value="class">Class</option>
                </select>
                <button
                  type="button"
                  class="cefilter-sort-order-btn"
                  id="servantInfoSortDirBtn"
                  data-order="asc"
                  aria-label="Sort ascending"
                  title="Sort ascending"
                >
                  <span class="cefilter-sort-order-icon">&#9650;</span>
                </button>
              </div>
              <div class="cefilter-pagination" id="servantInfoPaginationTop"></div>
              <div class="cefilter-results-grid grid" id="servantInfoResults"></div>
              <div class="cefilter-pagination" id="servantInfoPaginationBottom"></div>
            </div>
          </div>
        </section>

        <section class="tab-panel" id="panel-event" role="tabpanel" aria-labelledby="tab-event">
          <div class="card" id="eventSelectCard">
            <div class="card-inner">
              <div class="card-title">Select Event</div>
              <div class="input-row">
                <label class="input-label" for="eventServerSelect">Server</label>
                <select class="select-field" id="eventServerSelect">
                  <option value="JP">JP</option>
                  <option value="NA">NA</option>
                  <option value="CN">CN</option>
                  <option value="TW">TW</option>
                  <option value="KR">KR</option>
                </select>
              </div>
              <div class="input-row">
                <label class="input-label" for="eventSelect">Event</label>
                <select class="select-field" id="eventSelect"></select>
              </div>
              <div class="input-row">
                <label class="input-label" for="questTypeSelect">Quest</label>
                <select class="select-field" id="questTypeSelect" tabindex="-1" disabled>
                  <option value="free">Free Quest</option>
                  <option value="raid">Raid Boss</option>
                </select>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-inner">
              <div class="card-title">Drop Rates per Run</div>
            <div class="base-row">
              <div class="base-item">
                <label class="base-label" for="baseDrop">Base</label>
                <input
                  type="number"
                  class="input-field base-input"
                  id="baseDrop"
                  value="3"
                  min="0"
                  max="100"
                  step="1"
                  inputmode="numeric"
                />
              </div>
              <div class="base-item">
                <label class="base-label" for="primaryMultiplier"
                  >Primary %</label
                >
                <input
                  type="number"
                  class="input-field base-input"
                  id="primaryMultiplier"
                  value="1500"
                  min="100"
                  max="100000"
                  step="1"
                  inputmode="numeric"
                />
              </div>
              <div class="base-item">
                <label class="base-label" for="secondaryMultiplier"
                  >Secondary %</label
                >
                <input
                  type="number"
                  class="input-field base-input"
                  id="secondaryMultiplier"
                  value="225"
                  min="100"
                  max="100000"
                  step="1"
                  inputmode="numeric"
                />
              </div>
            </div>
            <div class="quest-drops-grid grid" id="questDropsGrid">
              <div class="quest-drops-item" data-tier="bronze">
                <div class="quest-drops-title">Bronze Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="bronzeQuest_bronze_icon"></span>
                  <span class="drop-material" id="bronzeQuest_bronze_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="bronzeQuest_bronze">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="bronzeQuest_silver_icon"></span>
                  <span class="drop-material" id="bronzeQuest_silver_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="bronzeQuest_silver">0</span>
                </div>
              </div>
              <div class="quest-drops-item" data-tier="silver">
                <div class="quest-drops-title">Silver Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="silverQuest_silver_icon"></span>
                  <span class="drop-material" id="silverQuest_silver_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="silverQuest_silver">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="silverQuest_gold_icon"></span>
                  <span class="drop-material" id="silverQuest_gold_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="silverQuest_gold">0</span>
                </div>
              </div>
              <div class="quest-drops-item" data-tier="gold">
                <div class="quest-drops-title">Gold Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="goldQuest_gold_icon"></span>
                  <span class="drop-material" id="goldQuest_gold_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="goldQuest_gold">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="goldQuest_bronze_icon"></span>
                  <span class="drop-material" id="goldQuest_bronze_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="goldQuest_bronze">0</span>
                </div>
              </div>
            </div>
            <div class="farm-grid" id="farmGrid">
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="bronze">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="silver">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="gold">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--combo farm-card--pre farm-card--pre-combo">
                <div class="farm-card-title farm-card-title--icons">
                  <span class="farm-card-icon"></span>
                  <span class="farm-card-icon"></span>
                  <span class="farm-card-icon"></span>
                </div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="farm-combo-drops">
                    <div class="drop-line"><span class="mini-icon"></span></div>
                    <div class="drop-line"><span class="mini-icon"></span></div>
                    <div class="drop-line"><span class="mini-icon"></span></div>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>

          <div class="card">
            <div class="card-inner">
              <div class="card-title">Shop Requirements</div>
            <div class="materials-grid grid" id="materialsGrid">
              <div class="material-card" data-tier="bronze">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="bronzeIcon"></div>
                </div>
                <div class="material-name">Bronze</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="bronzeNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="bronzeNeed"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="bronzeHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="bronzeHave"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
              </div>
              <div class="material-card" data-tier="silver">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="silverIcon"></div>
                </div>
                <div class="material-name">Silver</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="silverNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="silverNeed"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="silverHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="silverHave"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
              </div>
              <div class="material-card" data-tier="gold">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="goldIcon"></div>
                </div>
                <div class="material-name">Gold</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="goldNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="goldNeed"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="goldHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="goldHave"
                    min="0"
                    max="999999"
                    step="1"
                    inputmode="numeric"
                    value="0"
                  />
                </div>
              </div>
            </div>
              <div class="bonus-ce-grid grid" id="bonusCeGrid"></div>
              <div class="bond-card-actions bond-card-actions--end">
                <div class="material-input-box eshop-ce-equip-box" id="ceBonusEquipWrap" hidden>
                  <label class="material-input-box-label" for="ceBonusEquipInput">CE Bonus Equip</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="ceBonusEquipInput"
                    min="1"
                    max="6"
                    step="1"
                    value="6"
                    inputmode="numeric"
                  />
                </div>
                <button class="calculate-btn" id="calculateBtn" type="button">
                  Calculate Quest Runs
                </button>
              </div>
            </div>
          </div>

          <div class="results" id="results" aria-live="polite">
            <div class="card results-card">
              <div class="card-inner">
                <div class="card-title">Items Needed</div>
              <div class="deficit-grid grid" id="deficitGrid">
                <div class="deficit-item" data-tier="bronze">
                  <div class="deficit-label">Bronze</div>
                  <div class="deficit-value" id="bronzeDeficit">0</div>
                </div>
                <div class="deficit-item" data-tier="silver">
                  <div class="deficit-label">Silver</div>
                  <div class="deficit-value" id="silverDeficit">0</div>
                </div>
                <div class="deficit-item" data-tier="gold">
                  <div class="deficit-label">Gold</div>
                  <div class="deficit-value" id="goldDeficit">0</div>
                </div>
              </div>

              <div class="quest-results">
                <div class="quest-title">Recommended Quest Runs</div>
                <div class="quest-grid grid" id="questGrid">
                  <div class="quest-item" data-tier="bronze">
                    <div class="quest-name">Bronze Quest</div>
                    <div class="quest-count" id="bronzePlay">0</div>
                    <div class="quest-label" id="bronzeLabel">runs</div>
                  </div>
                  <div class="quest-item" data-tier="silver">
                    <div class="quest-name">Silver Quest</div>
                    <div class="quest-count" id="silverPlay">0</div>
                    <div class="quest-label" id="silverLabel">runs</div>
                  </div>
                  <div class="quest-item" data-tier="gold">
                    <div class="quest-name">Gold Quest</div>
                    <div class="quest-count" id="goldPlay">0</div>
                    <div class="quest-label" id="goldLabel">runs</div>
                  </div>
                </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="tab-panel" id="panel-bond" role="tabpanel" aria-labelledby="tab-bond">
          <div class="card">
            <div class="card-inner bond-quest-card-inner">
              <div class="card-title">Select Quest</div>
              <div class="bond-quest-tabs" id="bondQuestTabs" role="tablist" aria-label="Quest Type">
                <button
                  type="button"
                  class="tab-btn bond-quest-tab-btn active"
                  data-quest-family="fq"
                  role="tab"
                  aria-selected="true"
                >
                  Free Quest
                </button>
                <button
                  type="button"
                  class="tab-btn bond-quest-tab-btn"
                  data-quest-family="rb"
                  role="tab"
                  aria-selected="false"
                  aria-label="Raid Boss/Bleached Earth"
                  title="Raid Boss/Bleached Earth"
                >
                  Raid / Bleached
                </button>
                <button
                  type="button"
                  class="tab-btn bond-quest-tab-btn"
                  data-quest-family="gd"
                  role="tab"
                  aria-selected="false"
                >
                  Grand Duel/Raid
                </button>
              </div>

              <div class="bond-quest-panel bond-quest-panel--free" data-quest-panel="fq">
                <div class="bond-quest-grid">
                  <div class="bond-quest-field">
                    <label class="bond-quest-field-label" for="customApPerRun">AP / Run</label>
                    <input
                      type="number"
                      class="input-field bond-quest-input"
                      id="customApPerRun"
                      min="0"
                      max="999"
                      value="22"
                      inputmode="numeric"
                    />
                  </div>
                  <div class="bond-quest-field">
                    <label class="bond-quest-field-label" for="freeQuestRecLv">REC Lv.</label>
                    <input
                      type="number"
                      class="input-field bond-quest-input"
                      id="freeQuestRecLv"
                      min="1"
                      max="90"
                      value="84"
                      inputmode="numeric"
                    />
                  </div>
                </div>
                <div class="bond-quest-field bond-quest-field--full">
                  <span class="bond-quest-field-label" id="freeQuestTierLabel">Plus / Star</span>
                  <div
                    class="bond-tier-pills"
                    id="freeQuestTierPills"
                    role="radiogroup"
                    aria-labelledby="freeQuestTierLabel"
                  >
                    {QUEST_TIERS.map((t, idx) => (
                      <button
                        type="button"
                        class={idx === 0 ? "bond-tier-pill active" : "bond-tier-pill"}
                        role="radio"
                        data-value={t.key}
                        aria-label={t.label}
                        aria-checked={idx === 0 ? "true" : "false"}
                        tabindex={idx === 0 ? 0 : -1}
                      >
                        {t.label}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              <div class="bond-quest-panel bond-quest-panel--raid" data-quest-panel="rb">
                <div class="bond-quest-grid">
                  <div class="bond-quest-field">
                    <label class="bond-quest-field-label" for="raidApPerRun">AP / Run</label>
                    <input
                      type="number"
                      class="input-field bond-quest-input"
                      id="raidApPerRun"
                      min="0"
                      max="999"
                      value="40"
                      inputmode="numeric"
                    />
                  </div>
                  <div class="bond-quest-field">
                    <label class="bond-quest-field-label" for="raidRecLv">REC Lv.</label>
                    <input
                      type="number"
                      class="input-field bond-quest-input"
                      id="raidRecLv"
                      min="1"
                      max="90"
                      value="90"
                      inputmode="numeric"
                    />
                  </div>
                </div>
                <div class="bond-quest-field bond-quest-field--full">
                  <span class="bond-quest-field-label" id="raidTierLabel">Plus / Star</span>
                  <div
                    class="bond-tier-pills"
                    id="raidTierPills"
                    role="radiogroup"
                    aria-labelledby="raidTierLabel"
                  >
                    {QUEST_TIERS.map((t, idx) => (
                      <button
                        type="button"
                        class={idx === 0 ? "bond-tier-pill active" : "bond-tier-pill"}
                        role="radio"
                        data-value={t.key}
                        aria-label={t.label}
                        aria-checked={idx === 0 ? "true" : "false"}
                        tabindex={idx === 0 ? 0 : -1}
                      >
                        {t.label}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              <div class="bond-quest-panel bond-quest-panel--grand" data-quest-panel="gd">
                <div class="bond-quest-field bond-quest-field--full">
                  <label class="bond-quest-field-label" for="bondGrandClassSelect">Class</label>
                  <select class="select-field bond-quest-select" id="bondGrandClassSelect">
                    {GRAND_CLASSES.map((c) => (
                      <option value={c.key}>{c.name}</option>
                    ))}
                  </select>
                </div>
                <div class="bond-quest-field bond-quest-field--full">
                  <span class="bond-quest-field-label" id="grandDiffLabel">REC Lv.</span>
                  <div
                    class="bond-tier-pills bond-tier-pills--grand"
                    id="bondGrandDiffPills"
                    role="radiogroup"
                    aria-labelledby="grandDiffLabel"
                  >
                    {GRAND_DIFFICULTIES.map((d, idx) => (
                      <button
                        type="button"
                        class={idx === 0 ? "bond-tier-pill active" : "bond-tier-pill"}
                        role="radio"
                        data-value={d.key}
                        aria-label={d.lv}
                        aria-checked={idx === 0 ? "true" : "false"}
                        tabindex={idx === 0 ? 0 : -1}
                      >
                        {d.lv.replace(/^Lv\./, "")}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              <dl class="bond-quest-summary" id="bondQuestSummary" aria-live="polite">
                <div class="bond-quest-summary-item">
                  <dt class="bond-quest-summary-label">AP / Run</dt>
                  <dd class="bond-quest-summary-value" id="bondSummaryAp">22</dd>
                </div>
                <div class="bond-quest-summary-item">
                  <dt class="bond-quest-summary-label">REC Lv.</dt>
                  <dd class="bond-quest-summary-value" id="bondSummaryRecLv">84</dd>
                </div>
                <div class="bond-quest-summary-item bond-quest-summary-item--highlight">
                  <dt class="bond-quest-summary-label">Bond / Run</dt>
                  <dd class="bond-quest-summary-value bond-quest-summary-value--accent" id="bondSummaryBond">855</dd>
                </div>
              </dl>

              <script is:inline define:vars={{ tiers: QUEST_TIERS, gdDiffs: GRAND_DIFFICULTIES }}>(function () {
                var b = null;
                try {
                  var raw = localStorage.getItem("fgo_bond_calculator_data");
                  if (raw) {
                    var parsed = JSON.parse(raw);
                    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) b = parsed;
                  }
                } catch (e) {}

                var q = document.documentElement.getAttribute("data-bond-quest") || (b && (b.questMain === "gd" || b.questMain === "rb") ? b.questMain : "fq");
                var btns = document.querySelectorAll("#bondQuestTabs .bond-quest-tab-btn");
                for (var i = 0; i < btns.length; i++) {
                  var on = btns[i].getAttribute("data-quest-family") === q;
                  btns[i].classList.toggle("active", on);
                  btns[i].setAttribute("aria-selected", on ? "true" : "false");
                }

                function clampInt(v, min, max, fallback) {
                  var n = Number(v);
                  if (!isFinite(n)) return fallback;
                  return Math.floor(Math.max(min, Math.min(max, n)));
                }
                function syncPills(id, val) {
                  var el = document.getElementById(id);
                  if (!el) return;
                  var pills = el.querySelectorAll(".bond-tier-pill");
                  for (var j = 0; j < pills.length; j++) {
                    var hit = pills[j].getAttribute("data-value") === val;
                    pills[j].classList.toggle("active", hit);
                    pills[j].setAttribute("aria-checked", hit ? "true" : "false");
                    pills[j].tabIndex = hit ? 0 : -1;
                  }
                }
                function stepMap(list) {
                  var m = {};
                  for (var k = 0; k < list.length; k++) m[list[k].key] = list[k].steps;
                  return m;
                }
                function applyTier(base, steps) {
                  var v = base;
                  for (var s = 0; s < steps; s++) v = Math.ceil(v * 1.2);
                  return v;
                }

                var tierSteps = stepMap(tiers);
                var customAp = b && b.customAp !== undefined ? clampInt(b.customAp, 0, 999, 22) : 22;
                var customRecLv = b && b.customRecLv !== undefined ? clampInt(b.customRecLv, 1, 90, 84) : 84;
                var customTier = b && typeof b.customTier === "string" && tierSteps[b.customTier] !== undefined ? b.customTier : "";
                var raidAp = b && b.raidAp !== undefined ? clampInt(b.raidAp, 0, 999, 40) : 40;
                var raidRecLv = b && b.raidRecLv !== undefined ? clampInt(b.raidRecLv, 1, 90, 90) : 90;
                var raidTier = b && typeof b.raidTier === "string" && tierSteps[b.raidTier] !== undefined ? b.raidTier : "";
                var questClass = b && typeof b.questClass === "string" && b.questClass ? b.questClass : "all";
                var questDiff = b && typeof b.questDiff === "string" ? b.questDiff : "1";

                var gdEntry = gdDiffs[0];
                for (var d = 0; d < gdDiffs.length; d++) {
                  if (gdDiffs[d].key === questDiff) {
                    gdEntry = gdDiffs[d];
                    break;
                  }
                }
                questDiff = gdEntry.key;

                var el;
                if ((el = document.getElementById("customApPerRun"))) el.value = String(customAp);
                if ((el = document.getElementById("freeQuestRecLv"))) el.value = String(customRecLv);
                if ((el = document.getElementById("raidApPerRun"))) el.value = String(raidAp);
                if ((el = document.getElementById("raidRecLv"))) el.value = String(raidRecLv);
                if ((el = document.getElementById("bondGrandClassSelect"))) {
                  el.value = questClass;
                  if (!el.value) el.value = "all";
                }

                syncPills("freeQuestTierPills", customTier);
                syncPills("raidTierPills", raidTier);
                syncPills("bondGrandDiffPills", questDiff);

                var apOut = customAp;
                var recOut = String(customRecLv) + customTier;
                var bondOut = applyTier(customRecLv * 10 + 15, tierSteps[customTier] || 0);
                if (q === "gd") {
                  apOut = 40;
                  recOut = gdEntry.lv.replace(/^Lv\./, "");
                  bondOut = gdEntry.bond;
                } else if (q === "rb") {
                  apOut = raidAp;
                  recOut = String(raidRecLv) + raidTier;
                  bondOut = applyTier((raidRecLv * 10 + 15) * 2, tierSteps[raidTier] || 0);
                }

                var apEl = document.getElementById("bondSummaryAp");
                var recEl = document.getElementById("bondSummaryRecLv");
                var bondEl = document.getElementById("bondSummaryBond");
                if (apEl) apEl.textContent = String(apOut);
                if (recEl) recEl.textContent = recOut;
                if (bondEl) bondEl.textContent = bondOut.toLocaleString();
              })();</script>
