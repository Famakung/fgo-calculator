---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<div class="container">
      <nav class="navbar">
        <span class="navbar-title">FGO Calculator</span>
        <div class="navbar-tabs">
          <button class="tab-btn active" data-tab="cefilter">Bond Gain CE</button>
          <button class="tab-btn" data-tab="bond">Bond Calculator</button>
          <button class="tab-btn" data-tab="event">Event Shop</button>
        </div>
        <button class="navbar-hamburger" type="button" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <div class="navbar-dropdown" aria-hidden="true">
          <button class="navbar-dropdown-item active" data-tab="cefilter">Bond Gain CE</button>
          <button class="navbar-dropdown-item" data-tab="bond">Bond Calculator</button>
          <button class="navbar-dropdown-item" data-tab="event">Event Shop</button>
        </div>
      </nav>

      <main id="main-content">
        <section class="tab-panel" id="panel-event">
          <div class="card" id="eventSelectCard">
            <div class="card-inner">
              <div class="card-title">Select Event</div>
              <div class="input-row">
                <label class="input-label" for="eventSelect">Event</label>
                <select class="select-field" id="eventSelect"></select>
              </div>
              <div class="input-row">
                <label class="input-label" for="questTypeSelect">Quest</label>
                <select class="select-field" id="questTypeSelect">
                  <option value="free">Free Quest</option>
                  <option value="raid">Raid Boss</option>
                </select>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-inner">
              <div class="card-title">Drop Rates per Run</div>
            <div class="base-row">
              <div class="base-item">
                <label class="base-label" for="baseDrop">Base</label>
                <input
                  type="number"
                  class="input-field base-input"
                  id="baseDrop"
                  value="3"
                  min="0"
                  max="100"
                />
              </div>
              <div class="base-item">
                <label class="base-label" for="primaryMultiplier"
                  >Primary %</label
                >
                <input
                  type="number"
                  class="input-field base-input"
                  id="primaryMultiplier"
                  value="1500"
                  min="100"
                  max="100000"
                />
              </div>
              <div class="base-item">
                <label class="base-label" for="secondaryMultiplier"
                  >Secondary %</label
                >
                <input
                  type="number"
                  class="input-field base-input"
                  id="secondaryMultiplier"
                  value="225"
                  min="100"
                  max="100000"
                />
              </div>
            </div>
            <div class="quest-drops-grid grid" id="questDropsGrid">
              <div class="quest-drops-item" data-tier="bronze">
                <div class="quest-drops-title">Bronze Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="bronzeQuest_bronze_icon"></span>
                  <span class="drop-material" id="bronzeQuest_bronze_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="bronzeQuest_bronze">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="bronzeQuest_silver_icon"></span>
                  <span class="drop-material" id="bronzeQuest_silver_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="bronzeQuest_silver">0</span>
                </div>
              </div>
              <div class="quest-drops-item" data-tier="silver">
                <div class="quest-drops-title">Silver Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="silverQuest_silver_icon"></span>
                  <span class="drop-material" id="silverQuest_silver_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="silverQuest_silver">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="silverQuest_gold_icon"></span>
                  <span class="drop-material" id="silverQuest_gold_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="silverQuest_gold">0</span>
                </div>
              </div>
              <div class="quest-drops-item" data-tier="gold">
                <div class="quest-drops-title">Gold Quest</div>
                <div class="drop-line">
                  <span class="mini-icon" id="goldQuest_gold_icon"></span>
                  <span class="drop-material" id="goldQuest_gold_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="goldQuest_gold">0</span>
                </div>
                <div class="drop-line">
                  <span class="mini-icon" id="goldQuest_bronze_icon"></span>
                  <span class="drop-material" id="goldQuest_bronze_label"
                    >3(+0)</span
                  >
                  <span class="drop-value" id="goldQuest_bronze">0</span>
                </div>
              </div>
            </div>
            <div class="farm-grid grid" id="farmGrid">
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="bronze">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="silver">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--pre" data-tier="gold">
                <div class="farm-card-title"><span class="farm-card-icon"></span></div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                  <div class="drop-line"><span class="mini-icon"></span></div>
                </div>
              </div>
              <div class="quest-drops-item farm-card farm-card--combo farm-card--pre farm-card--pre-combo">
                <div class="farm-card-title farm-card-title--icons">
                  <span class="farm-card-icon"></span>
                  <span class="farm-card-icon"></span>
                  <span class="farm-card-icon"></span>
                </div>
                <div class="farm-card-body">
                  <select class="select-field farm-quest-select" aria-label="Farm quest" disabled></select>
                  <div class="farm-stat farm-quest-name"></div>
                  <div class="farm-stat"></div>
                  <div class="farm-combo-drops">
                    <div class="drop-line"><span class="mini-icon"></span></div>
                    <div class="drop-line"><span class="mini-icon"></span></div>
                    <div class="drop-line"><span class="mini-icon"></span></div>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>

          <div class="card">
            <div class="card-inner">
              <div class="card-title">Shop Requirements</div>
            <div class="materials-grid grid" id="materialsGrid">
              <div class="material-card" data-tier="bronze">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="bronzeIcon"></div>
                </div>
                <div class="material-name">Bronze</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="bronzeNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="bronzeNeed"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="bronzeHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="bronzeHave"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
              </div>
              <div class="material-card" data-tier="silver">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="silverIcon"></div>
                </div>
                <div class="material-name">Silver</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="silverNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="silverNeed"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="silverHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="silverHave"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
              </div>
              <div class="material-card" data-tier="gold">
                <div class="material-icon-wrapper">
                  <div class="material-icon" id="goldIcon"></div>
                </div>
                <div class="material-name">Gold</div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="goldNeed">Required</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="goldNeed"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
                <div class="material-input-box">
                  <label class="material-input-box-label" for="goldHave">Held</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="goldHave"
                    min="0"
                    max="999999"
                    value="0"
                  />
                </div>
              </div>
            </div>
              <div class="bonus-ce-grid grid" id="bonusCeGrid"></div>
              <div class="bond-card-actions bond-card-actions--end">
                <div class="material-input-box eshop-ce-equip-box" id="ceBonusEquipWrap">
                  <label class="material-input-box-label" for="ceBonusEquipInput">CE Bonus Equip</label>
                  <input
                    type="number"
                    class="material-input-box-field"
                    id="ceBonusEquipInput"
                    min="1"
                    max="6"
                    step="1"
                    value="6"
                    inputmode="numeric"
                  />
                </div>
                <button class="calculate-btn" id="calculateBtn" type="button">
                  Calculate Quest Runs
                </button>
              </div>
            </div>
          </div>

          <div class="results" id="results">
            <div class="card results-card">
              <div class="card-inner">
                <div class="card-title">Items Needed</div>
              <div class="deficit-grid grid" id="deficitGrid">
                <div class="deficit-item" data-tier="bronze">
                  <div class="deficit-label">Bronze</div>
                  <div class="deficit-value" id="bronzeDeficit">0</div>
                </div>
                <div class="deficit-item" data-tier="silver">
                  <div class="deficit-label">Silver</div>
                  <div class="deficit-value" id="silverDeficit">0</div>
                </div>
                <div class="deficit-item" data-tier="gold">
                  <div class="deficit-label">Gold</div>
                  <div class="deficit-value" id="goldDeficit">0</div>
                </div>
              </div>

              <div class="quest-results">
                <div class="quest-title">Recommended Quest Runs</div>
                <div class="quest-grid grid" id="questGrid">
                  <div class="quest-item" data-tier="bronze">
                    <div class="quest-name">Bronze Quest</div>
                    <div class="quest-count" id="bronzePlay">0</div>
                    <div class="quest-label" id="bronzeLabel">runs</div>
                  </div>
                  <div class="quest-item" data-tier="silver">
                    <div class="quest-name">Silver Quest</div>
                    <div class="quest-count" id="silverPlay">0</div>
                    <div class="quest-label" id="silverLabel">runs</div>
                  </div>
                  <div class="quest-item" data-tier="gold">
                    <div class="quest-name">Gold Quest</div>
                    <div class="quest-count" id="goldPlay">0</div>
                    <div class="quest-label" id="goldLabel">runs</div>
                  </div>
                </div>
              </div>
              </div>
            </div>
          </div>
        </section>

        <section class="tab-panel" id="panel-bond">
          <div class="card">
            <div class="card-inner">
              <div class="card-title">Select Quest</div>
            <div class="input-row">
              <label class="input-label" for="bondQuestSelect">Main</label>
              <select class="select-field" id="bondQuestSelect">
                <option value="">-- Select a Quest --</option>
              </select>
            </div>
            <div class="input-row bond-quest-row--free">
              <label class="input-label" for="bondFreeQuestSelect">Quest</label>
              <select class="select-field" id="bondFreeQuestSelect">
                <option value="">-- Select --</option>
              </select>
            </div>
            <div class="input-row bond-quest-row--grand">
              <label class="input-label" for="bondGrandClassSelect">Class</label>
              <select class="select-field" id="bondGrandClassSelect">
                <option value="">-- Select --</option>
              </select>
            </div>
            <div class="input-row bond-quest-row--grand">
              <label class="input-label" for="bondGrandDiffSelect">Difficulty</label>
              <select class="select-field" id="bondGrandDiffSelect">
                <option value="">-- Select --</option>
              </select>
            </div>
            <div id="customQuestSection" class="custom-quest-section">
              <div class="input-row">
                <label class="input-label" for="customBondPerRun"
                  >Bond/Run</label
                >
                <input
                  type="number"
                  class="input-field"
                  id="customBondPerRun"
                  min="0"
                  max="99999"
                  value="0"
                  disabled
                />
              </div>
              <div class="input-row">
                <label class="input-label" for="customApPerRun"
                  >AP/Run</label
                >
                <input
                  type="number"
                  class="input-field"
                  id="customApPerRun"
                  min="0"
                  max="999"
                  value="22"
                  disabled
                />
              </div>
            </div>
            </div>
          </div>

          <div class="card">
            <div class="card-inner">
              <div class="card-title">Party Setup</div>
            <div class="servant-grid grid" id="servantGrid">
              <div class="bond-group-label bond-group-label--frontline">Starting Member</div>
              <div class="servant-slot servant-slot--frontline servant-add-slot" data-slot-index="0">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
              <div class="servant-slot servant-slot--frontline servant-add-slot" data-slot-index="1">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
              <div class="servant-slot servant-slot--frontline servant-add-slot" data-slot-index="2">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
              <div class="bond-group-label bond-group-label--backline">Sub Member</div>
              <div class="servant-slot servant-slot--backline servant-add-slot" data-slot-index="3">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
              <div class="servant-slot servant-slot--backline servant-add-slot" data-slot-index="4">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
              <div class="servant-slot servant-slot--backline servant-add-slot" data-slot-index="5">
                <div class="servant-slot-portrait-fallback">+</div>
                <div><div class="servant-slot-name">Add Servant</div></div>
              </div>
            </div>
            <div class="bond-card-actions">
              <div class="bond-max-ap">
                <img
                  class="bond-max-ap-img"
                  src="icons/100_bordered.webp"
                  alt="Max AP"
                  width="142"
                  height="155"
                />
                <div class="bond-input-box bond-max-ap-box">
                  <label class="bond-input-box-label" for="maxApInput">Max AP</label>
                  <input
                    class="bond-input-box-field bond-max-ap-input"
                    id="maxApInput"
                    type="number"
                    min="1"
                    max="999"
                    step="1"
                    value="152"
                    inputmode="numeric"
                  />
                </div>
              </div>
              <div class="bond-teapot">
                <img
                  class="bond-teapot-img"
                  src="icons/teapot.webp"
                  alt="Stargazer's Teapot"
                  width="142"
                  height="155"
                />
                <div class="bond-input-box bond-teapot-box">
                  <label class="bond-input-box-label" for="teapotCountInput">Stargazer's Teapot</label>
                  <input
                    class="bond-input-box-field bond-teapot-input"
                    id="teapotCountInput"
                    type="number"
                    min="0"
                    max="9999"
                    step="1"
                    value="0"
                    inputmode="numeric"
                  />
                </div>
                <label class="bond-teapot-switch" for="teapotToggle">
                  <input type="checkbox" id="teapotToggle" aria-label="Use Stargazer's Teapot" />
                  <span class="bond-teapot-slider" aria-hidden="true"></span>
                </label>
              </div>
              <button class="calculate-btn" id="bondCalculateBtn" type="button">
                Calculate Quest Runs
              </button>
            </div>
            </div>
          </div>

          <div class="results" id="bondResults">
            <div class="card results-card">
              <div class="card-inner">
                <div class="card-title">Bond Quest Runs</div>
                <div id="bondResultContent"></div>
              </div>
            </div>
          </div>
        </section>

        <section class="tab-panel active" id="panel-cefilter">
          <div class="card">
            <div class="card-inner">
              <div class="cefilter-subtabs" id="cefilterSubtabs">
                <button type="button" class="tab-btn cefilter-subtab-btn active" data-subtab="ce" aria-pressed="true">
                  Craft Essence Select
                </button>
                <button type="button" class="tab-btn cefilter-subtab-btn" data-subtab="servant" aria-pressed="false">
                  Servant Select
                </button>
              </div>

              <!-- The panels are already right: <html data-subtab> + CSS hide Craft Essence Select
                   before this parses. The buttons keep their look in a class, so they are flipped
                   here — as early in the parse as the markup allows. -->
              <script is:inline>(function () {
                if (document.documentElement.getAttribute("data-subtab") !== "servant") return;
                document.querySelectorAll(".cefilter-subtab-btn").forEach(function (b) {
                  var on = b.dataset.subtab === "servant";
                  b.classList.toggle("active", on);
                  b.setAttribute("aria-pressed", on ? "true" : "false");
                });
              })();</script>

              <div class="cefilter-subpanel" data-subpanel="ce">
                <div class="card-title">Craft Essences</div>
                <div class="cefilter-controls">
                  <button class="cefilter-add-btn" id="cefilterAddBtn" type="button">Add Craft Essence</button>
                  <button
                    class="cefilter-add-btn cefilter-add-btn--clear"
                    id="cefilterClearBtn"
                    type="button"
                    hidden
                  >
                    Clear all
                  </button>
                  <div class="cefilter-mode-row">
                    <label class="cefilter-mode-label" for="cefilterMode">Match Mode:</label>
                    <select class="select-field" id="cefilterMode">
                      <option value="all" selected>Match All (AND)</option>
                      <option value="any">Match Any (OR)</option>
                      <option value="custom">Custom Match</option>
                    </select>
                    <div id="cefilterCustomCount" class="cefilter-custom-count"></div>
                  </div>
                </div>
                <div class="cefilter-chips" id="cefilterChips"></div>
              </div>

              <div class="cefilter-subpanel" data-subpanel="servant" hidden>
                <div class="card-title">Servants</div>
                <div class="cefilter-controls">
                  <button class="cefilter-add-btn" id="cefilterServantAddBtn" type="button">Add Servant</button>
                  <button
                    class="cefilter-add-btn cefilter-add-btn--clear"
                    id="cefilterServantClearBtn"
                    type="button"
                    hidden
                  >
                    Clear all
                  </button>
                </div>
                <div class="cefilter-chips" id="cefilterServantChips"></div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-inner">
              <div class="cefilter-subpanel" data-subpanel="ce">
                <div class="card-title cefilter-results-header">
                  <span>Servants</span>
                </div>
                <div class="cefilter-search-container">
                  <input
                    type="text"
                    class="search-filter cefilter-search-input"
                    id="cefilterSearchInput"
                    placeholder="Search by ID or name..."
                    autocomplete="off"
                  />
                </div>
                <div class="cefilter-sort-row">
                  <button
                    type="button"
                    class="cefilter-filter-btn"
                    id="cefilterFilterBtn"
                    aria-haspopup="dialog"
                    aria-label="Open filter settings modal"
                  >
                    Filter
                  </button>
                  <select class="select-field cefilter-sort-select" id="cefilterSortBy" aria-label="Sort by">
                    <option value="id" selected>ID</option>
                    <option value="rarity">Rarity</option>
                    <option value="class">Class</option>
                  </select>
                  <button
                    type="button"
                    class="cefilter-sort-order-btn"
                    id="cefilterSortOrderToggle"
                    data-order="asc"
                    aria-label="Sort ascending"
                    title="Sort ascending"
                  >
                    <span class="cefilter-sort-order-icon">&#9650;</span>
                  </button>
                </div>
                <div class="cefilter-pagination" id="cefilterPaginationTop"></div>
                <div class="cefilter-results-grid grid" id="cefilterResults"></div>

                <div class="cefilter-pagination" id="cefilterPaginationBottom"></div>
              </div>

              <div class="cefilter-subpanel" data-subpanel="servant" hidden>
                <div class="card-title cefilter-results-header">
                  <span>Shared Craft Essences</span>
                </div>
                <div class="cefilter-pagination" id="cefilterComboPaginationTop"></div>
                <div class="cefilter-combo-results" id="cefilterComboResults"></div>
                <div class="cefilter-pagination" id="cefilterComboPaginationBottom"></div>
                <div class="cefilter-combo-empty" id="cefilterComboEmpty" hidden></div>
                <div class="cefilter-combo-unshared" id="cefilterComboUnshared" hidden></div>
                <div class="cefilter-combo-truncated" id="cefilterComboTruncated" hidden>Too many combinations — remove a servant.</div>
              </div>
            </div>
          </div>
        </section>

        <!-- Servant Selector Modal -->
        <div class="servant-modal" id="servantModal" role="dialog" aria-modal="true" aria-labelledby="servantModalTitle">
          <div class="servant-modal-content">
            <div class="servant-modal-header">
              <span class="ascension-modal-title" id="servantModalTitle">Select Servant</span>
              <button
                class="servant-modal-close"
                id="servantModalClose"
                type="button"
                aria-label="Close"
              >
                &#10005;
              </button>
            </div>
            <div class="cefilter-search-container">
              <input
                type="text"
                class="search-filter cefilter-search-input"
                id="servantPickerSearch"
                placeholder="Search by ID or name..."
                autocomplete="off"
              />
            </div>
            <div class="cefilter-sort-row">
              <button
                type="button"
                class="cefilter-filter-btn"
                id="servantPickerFilterBtn"
                aria-haspopup="dialog"
                aria-label="Open filter settings modal"
              >
                Filter
              </button>
