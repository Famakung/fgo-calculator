---
import { IMAGE_VERSION } from "../scripts/constants.js";
import { SERVANT_DATA } from "../scripts/data/servants.js";
import { EVENT_SHOP_DATA } from "../scripts/data/event_shop.js";
import { EventShop } from "../scripts/domain.js";

interface Props {
  title?: string;
  description?: string;
}

// First 6 servant IDs ordered by collectionNo for head preloading
const preloadServantIds = Object.entries(SERVANT_DATA)
  .sort(([, a], [, b]) => (a.collectionNo || 0) - (b.collectionNo || 0))
  .slice(0, 6)
  .map(([id]) => id);

const eventIds = (EVENT_SHOP_DATA.events || []).map((e) => e.event.id);
const comboEventIds = (EVENT_SHOP_DATA.events || [])
  .filter((e) => EventShop.allCoveringQuests(e.farm, (e.currencies || []).map((c) => c.id)).length > 0)
  .map((e) => e.event.id);
const raidEventIds = (EVENT_SHOP_DATA.events || [])
  .filter((e) => Array.isArray(e.farm?.raids) && e.farm.raids.length > 0)
  .map((e) => e.event.id);

// One source for the asset cache-buster: the preload script below takes it from define:vars, so a bump here reaches the preloads and the runtime src together.
const { title = 'FGO Calculator', description = 'FGO Calculator — Event Shop optimizer, Bond Point calculator, and Bond Gain CE for Fate/Grand Order farming.' } = Astro.props;
