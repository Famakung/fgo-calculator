# Agent guidance is tracked: CLAUDE.md + .wiki/ are the handoff contract for any
# AI assistant or fresh clone. Only local permission and session state stay ignored.
# `.claude/*` (not `.claude`) so the negations below can actually re-include.
.claude/*
!.claude/CLAUDE.md
.wiki/.research-session.json
.wiki/.thesis-session.json
.wiki/.sessions/
.plans
design-docs
node_modules/
/docs/
dist/
.astro/
.cache/
.ci-baselines/
public/servants/
public/servant_info/
public/saint_graphs/
public/craft_essences/
public/skill_icons/*
!public/skill_icons/.gitkeep
public/buff_icons/*
!public/buff_icons/.gitkeep
# Directory kept via .gitkeep (a bare `public/event_shop/` exclusion would block the negation).
public/event_shop/*
!public/event_shop/.gitkeep
src/scripts/data/*.js
!src/scripts/data/.gitkeep
__pycache__/
*.pyc

# Old esbuild outputs (no longer generated)
app.min.js
app.js
app.bundle.js
bond-lazy.min.js
event-lazy.min.js
chunk-*.min.js
ce-match-worker.min.js
styles.min.css

# Temp/test files
lighthouse-runner.js
.bin/
