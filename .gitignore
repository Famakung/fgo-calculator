# Agent guidance is tracked: CLAUDE.md + docs/ are the handoff contract for any
# AI assistant or fresh clone. Only local permission state stays ignored.
# `.claude/*` (not `.claude`) so the negations below can actually re-include.
.claude/*
!.claude/CLAUDE.md
!.claude/docs/
.plans
design-docs
node_modules/
/docs/
dist/
.astro/
.cache/
.ci-baselines/
public/servants/
public/craft_essences/
src/scripts/data/*.js
!src/scripts/data/.gitkeep
__pycache__/
*.pyc

# Old esbuild outputs (no longer generated)
app.min.js
app.js
app.bundle.js
bond-lazy.min.js
event-lazy.min.js
chunk-*.min.js
ce-match-worker.min.js
styles.min.css

