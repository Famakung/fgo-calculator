{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lighthouse": "node lighthouse-runner.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint src/scripts/",
    "lint:css": "stylelint src/styles/global.css",
    "format": "prettier --write \"src/scripts/**/*.js\" \"src/styles/*.css\" \"*.mjs\" && stylelint --fix src/styles/global.css",
    "format:check": "prettier --check \"src/scripts/**/*.js\" \"src/styles/*.css\" \"*.mjs\""
  },
  "dependencies": {
    "astro": "^5.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "lighthouse": "^13.3.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.0",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0"
  }
}