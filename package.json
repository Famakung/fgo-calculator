{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/ensure_data.js",
    "prebuild": "node scripts/ensure_data.js",
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "lint": "eslint src/scripts/",
    "format": "prettier --write \"src/scripts/**/*.js\" \"tests/**/*.js\" \"*.mjs\"",
    "format:check": "prettier --check \"src/scripts/**/*.js\" \"tests/**/*.js\" \"*.mjs\"",
    "test": "node --test \"tests/**/*.test.js\"",
    "data:sync": "python3 scripts/sync_atlas_data.py --clean-cache",
    "data:validate": "node scripts/validate_data.js",
    "check:build": "node scripts/check_build_output.js"
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.0"
  }
}
